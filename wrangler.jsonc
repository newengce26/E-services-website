{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "khadamat-market",
  "compatibility_date": "2026-07-10",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "khadamat-market-production",
      "database_id": "REPLACE_WITH_ACTUAL_ID"
    }
  ],
  "r2_buckets": [
    {
      "binding": "RECEIPTS",
      "bucket_name": "khadamat-market-receipts"
    }
  ]
}
